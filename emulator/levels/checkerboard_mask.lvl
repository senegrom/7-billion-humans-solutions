# Synthetic checkerboard target-mask regression.  The two marked squares are
# the requested pattern; other same-parity floor squares are intentionally not
# targets and must not prevent completion.
name Checkerboard Target Mask
dim 5 4
ent wall 0 0
ent wall 1 0
ent wall 2 0
ent wall 3 0
ent wall 4 0
ent wall 0 1
ent wall 4 1
ent wall 0 2
ent wall 4 2
ent wall 0 3
ent wall 1 3
ent wall 2 3
ent wall 3 3
ent wall 4 3
ent goal 1 1
ent goal 3 1
ent cube 1 1 7
ent cube 2 1 8
ent worker 2 2
goal checkerboard
